<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>Checks expense policy violations when an expense is created or updated</description>
    <label>Expense Violation Check</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Draft</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Policy</targetReference>
        </connector>
        <object>Expense__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <recordLookups>
        <name>Get_Policy</name>
        <label>Get Policy</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Check_Over_Limit</targetReference>
        </connector>
        <object>Expense_Policy__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Policy__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Check_Over_Limit</name>
        <label>Over Limit?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Check_Receipt_Required</targetReference>
        </defaultConnector>
        <rules>
            <name>Is_Over_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><elementReference>Get_Policy.Max_Expense_Amount__c</elementReference></rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Over_Limit_Violation</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Over_Limit_Violation</name>
        <label>Create Over Limit Violation</label>
        <locationX>50</locationX>
        <locationY>398</locationY>
        <connector>
            <targetReference>Check_Receipt_Required</targetReference>
        </connector>
        <object>Expense_Violation__c</object>
        <inputAssignments>
            <field>Expense__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Violation_Type__c</field>
            <value><stringValue>Over_Limit</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value><stringValue>Expense exceeds the maximum allowed amount</stringValue></value>
        </inputAssignments>
    </recordCreates>
    <decisions>
        <name>Check_Receipt_Required</name>
        <label>Receipt Required?</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Needs_Receipt</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue><elementReference>Get_Policy.Receipt_Required_Amount__c</elementReference></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Has_Receipt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Receipt_Violation</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Receipt_Violation</name>
        <label>Create Receipt Required Violation</label>
        <locationX>50</locationX>
        <locationY>638</locationY>
        <object>Expense_Violation__c</object>
        <inputAssignments>
            <field>Expense__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Violation_Type__c</field>
            <value><stringValue>Receipt_Required</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value><stringValue>Receipt is required for this expense amount</stringValue></value>
        </inputAssignments>
    </recordCreates>
</Flow>
