<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>Automatically submits expense reports on a scheduled basis for users with auto-reporting enabled</description>
    <label>Scheduled Expense Report Submit</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Draft</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Reports</targetReference>
        </connector>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2024-01-01</startDate>
            <startTime>09:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <recordLookups>
        <name>Get_Open_Reports</name>
        <label>Get Open Reports</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Loop_Reports</targetReference>
        </connector>
        <object>Expense_Report__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Open</stringValue></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <loops>
        <name>Loop_Reports</name>
        <label>Loop Reports</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <collectionReference>Get_Open_Reports</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Has_Expenses</targetReference>
        </nextValueConnector>
    </loops>
    <decisions>
        <name>Check_Has_Expenses</name>
        <label>Has Expenses?</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <defaultConnector>
            <targetReference>Loop_Reports</targetReference>
        </defaultConnector>
        <rules>
            <name>Yes_Has_Expenses</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Reports.Expense_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>0</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Report_Status</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Update_Report_Status</name>
        <label>Submit Report</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <connector>
            <targetReference>Loop_Reports</targetReference>
        </connector>
        <inputReference>Loop_Reports</inputReference>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Submitted</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_Date__c</field>
            <value><elementReference>$Flow.CurrentDateTime</elementReference></value>
        </inputAssignments>
    </recordUpdates>
</Flow>
