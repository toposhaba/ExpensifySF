<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>NetSuite</label>
    <type>SecuredEndpoint</type>
    <url>https://{accountId}.suitetalk.api.netsuite.com</url>
    <authenticationProtocol>OAuth2</authenticationProtocol>
    <oauthScope>rest_webservices</oauthScope>
    <allowMergeFieldsInBody>true</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
</NamedCredential>
