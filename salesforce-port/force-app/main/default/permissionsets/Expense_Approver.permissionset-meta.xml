<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Expense Approver</label>
    <description>Can approve and reject expense reports in addition to basic expense user permissions</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Expense__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
    </objectPermissions>
    <objectPermissions>
        <object>Expense_Report__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
    </objectPermissions>
    <objectPermissions>
        <object>Expense_Category__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
    </objectPermissions>
    <objectPermissions>
        <object>Expense_Tag__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
    </objectPermissions>
    <objectPermissions>
        <object>Expense_Policy__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
    </objectPermissions>
    <objectPermissions>
        <object>Expense_Violation__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
    </objectPermissions>
    <objectPermissions>
        <object>Payment__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
    </objectPermissions>
    <fieldPermissions>
        <field>Expense_Report__c.Status__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Expense_Report__c.Approved_Date__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Expense__c.Status__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Expense__c.Hold_Reason__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <customPermissions>
        <enabled>true</enabled>
        <name>Can_Approve_Reports</name>
    </customPermissions>
</PermissionSet>
